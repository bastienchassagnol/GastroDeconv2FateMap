po/*~

# RStudio Connect folder
rsconnect/


# my folders
slides/

# logs insctrution
logs/

# Keep raw data files ignored, but allow DVC pointer files.
# Note: use /** (not *) so the directory itself is not ignored;
# git cannot un-ignore files inside an ignored directory.
data/raw/**
!data/raw/*.dvc
!data/raw/.gitignore
data/intermediate/**
!data/intermediate/*.dvc
!data/intermediate/.gitignore
docs
**/.quarto/
.models/

outputs/gene_regulatory_networks/**
outputs/phenotype-aware/*.rds

